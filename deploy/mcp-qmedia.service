[Unit]
Description=mcp-qmedia daemon: MCP over SSE (/sse) + web UI (providers, API keys, media probe) on 127.0.0.1:8938
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Defaults; override in ~/.config/mcp-qmedia/env (copy deploy/env.example)
Environment=MCP_QMEDIA_DIR=%h/.local/src/ai-agent-setup/mcp/mcp-qmedia
Environment=MCP_QMEDIA_PYTHON=%h/.local/src/ai-agent-setup/mcp/mcp-qmedia/.venv/bin/python
EnvironmentFile=-%h/.config/mcp-qmedia/env
ExecStart=/usr/bin/env ${MCP_QMEDIA_PYTHON} ${MCP_QMEDIA_DIR}/server.py serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
