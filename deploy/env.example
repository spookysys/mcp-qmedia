# ~/.config/mcp-qmedia/env — optional. NO SECRETS: there are none left to keep
# here. Models and API keys belong to the captioning service; configure them at
# http://127.0.0.1:8937/ (Models tab) or in ~/.config/mcp-caption/.

# Where the captioning service lives.
#QMEDIA_SERVICE=http://127.0.0.1:8937

# How long to wait for an answer. Generous by default: the service may be
# transcoding a large video before it even calls a model.
#QMEDIA_TIMEOUT=600

# Launcher only.
#MCP_QMEDIA_PYTHON=/path/to/.venv/bin/python
#MCP_QMEDIA_ENV=~/.config/mcp-qmedia/env
