#!/usr/bin/env bash
# Launch qmedia: no args (or `serve [port]`) = the daemon (MCP over SSE + web UI on
# one port, default 8938 - what deploy/mcp-qmedia.service runs); `stdio` = a plain
# stdio MCP server for a client that cannot do SSE.
#
# Uses the venv inside the checkout by default; override the interpreter with
# MCP_QMEDIA_PYTHON. Resolves the checkout from its own location, so it can be
# symlinked anywhere (e.g. ln -s $PWD/deploy/bin/mcp-qmedia ~/.local/bin/).
# Optional non-secret settings: ~/.config/mcp-qmedia/env (copy deploy/env.example)
# or MCP_QMEDIA_ENV. The API key is NOT read here - the server takes it from
# QMEDIA_API_KEY / OPENCODE_API_KEY or opencode's own auth.json (see README).
set -euo pipefail
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
settings="${MCP_QMEDIA_ENV:-$HOME/.config/mcp-qmedia/env}"
if [[ -r "$settings" ]]; then
	# shellcheck source=/dev/null
	set -a; source "$settings"; set +a
fi
exec "${MCP_QMEDIA_PYTHON:-$repo/.venv/bin/python}" "$repo/server.py" "$@"
